# ============================================================
# Tanker Tracker — Environment Variables
# Copy this file to .env.local and fill in all values.
# ============================================================

# Database (TimescaleDB/PostgreSQL)
# Local Docker:  postgresql://postgres:password@localhost:5432/tanker_tracker
# Production:    get connection string from Timescale Cloud or Railway
DATABASE_URL=postgresql://user:password@host:5432/tanker_tracker

# AISStream.io WebSocket API — free tier at https://aisstream.io
AISSTREAM_API_KEY=your_aisstream_api_key

# JWT secret for session tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars

# bcrypt hash of the shared dashboard password — generate with:
#   node -e "const b=require('bcrypt'); b.hash('yourpassword',10).then(h=>console.log(h))"
PASSWORD_HASH=$2b$10$your_bcrypt_hash_here

# Mapbox access token for map rendering — OPTIONAL / NO LONGER REQUIRED
# The map now uses keyless MapLibre + CARTO basemaps, so no token is needed.
# This variable is retained only for legacy compatibility and can be left unset.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token

# Alpha Vantage API key for oil prices — OPTIONAL fallback
# Oil prices now use FRED as the primary source. Alpha Vantage is only an
# optional fallback; leaving this unset is fine.
# Get at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# FRED API key for oil prices (primary source) — OPTIONAL
# FRED is the primary oil price source. A key is optional and only raises the
# rate limits; the app works without one.
# Get at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# NewsAPI key for geopolitical headlines — OPTIONAL / NO LONGER REQUIRED
# News now uses a keyless RSS feed (Google News), so this key is optional.
# Get at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key
